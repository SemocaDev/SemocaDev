    {
      "cell_type": "code",
      "source": [
        "import pulp\n",
        "\n",
        "# 2. Inicialización del modelo de minimización\n",
        "modelo = pulp.LpProblem(\"Modelo_Transporte_MG_Auto\", pulp.LpMinimize)\n",
        "\n",
        "# 3. Definición de Nodos\n",
        "origenes = [\"Los_Angeles\", \"Detroit\", \"Nueva_Orleans\"]\n",
        "destinos = [\"Denver\", \"Miami\"]\n",
        "\n",
        "# 4. Parámetros de Oferta y Demanda\n",
        "oferta = {\n",
        "    \"Los_Angeles\": 1000,\n",
        "    \"Detroit\": 1500,\n",
        "    \"Nueva_Orleans\": 1200\n",
        "}\n",
        "\n",
        "demanda = {\n",
        "    \"Denver\": 2300,\n",
        "    \"Miami\": 1400\n",
        "}\n",
        "\n",
        "# 5. Matriz de Costos de Transporte (c_ij)\n",
        "costos = {\n",
        "    \"Los_Angeles\": {\"Denver\": 80, \"Miami\": 215},\n",
        "    \"Detroit\":     {\"Denver\": 100, \"Miami\": 108},\n",
        "    \"Nueva_Orleans\": {\"Denver\": 102, \"Miami\": 68}\n",
        "}\n",
        "\n",
        "# 6. Creación de Variables de Decisión (x_ij >= 0)\n",
        "# Creamos un diccionario de variables para cada combinación (Origen, Destino)\n",
        "rutas = [(i, j) for i in origenes for j in destinos]\n",
        "x = pulp.LpVariable.dicts(\"Envio\", (origenes, destinos), lowBound=0, cat='Continuous')\n",
        "\n",
        "# 7. Función Objetivo\n",
        "modelo += pulp.lpSum([costos[i][j] * x[i][j] for (i, j) in rutas]), \"Costo_Total_Transporte\"\n",
        "\n",
        "# 8. Restricciones de Oferta (Ecuaciones porque está balanceado 3700 = 3700)\n",
        "for i in origenes:\n",
        "    modelo += pulp.lpSum([x[i][j] for j in destinos]) == oferta[i], f\"Oferta_{i}\"\n",
        "\n",
        "# 9. Restricciones de Demanda\n",
        "for j in destinos:\n",
        "    modelo += pulp.lpSum([x[i][j] for i in origenes]) == demanda[j], f\"Demanda_{j}\"\n",
        "\n",
        "# 10. Resolver el modelo\n",
        "modelo.solve()\n",
        "\n",
        "# 11. Impresión de Resultados\n",
        "print(\"=\"*40)\n",
        "print(f\"Estado de la Solución: {pulp.LpStatus[modelo.status]}\")\n",
        "print(\"=\"*40)\n",
        "\n",
        "print(\"\\n PLAN DE ENVÍOS ÓPTIMO:\")\n",
        "for i in origenes:\n",
        "    for j in destinos:\n",
        "        if x[i][j].varValue > 0:\n",
        "            print(f\"Desde {i} hacia {j}: {int(x[i][j].varValue)} automóviles\")\n",
        "\n",
        "print(\"-\" * 40)\n",
        "print(f\" COSTO TOTAL MÍNIMO Z: ${int(pulp.value(modelo.objective))}\")"
      ],
